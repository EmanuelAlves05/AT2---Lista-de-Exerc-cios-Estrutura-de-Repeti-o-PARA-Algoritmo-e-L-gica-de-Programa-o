inteiro matricula
    real nota
    caracter conceito

    para(inteiro i=1; i <= 75; i++){
      escreva("Qual a matricula?\n")
      leia(matricula)

      escreva("Qual a nota?\n")
      leia(nota)

      se(nota >=0 e nota<=4.9){
        escreva("O conceito deste aluno é D")
     
      }senao se(nota>=5.0 e nota<=6.9){
        escreva("O conceito deste aluno é C")
      
      }senao se(nota>=7.0 e nota<=8.9){
        escreva("O conceito deste aluno é B")

      }senao{
        escreva("O conceito deste aluno é A")
}

      escreva("\nmatricula: ", matricula)
      escreva("\nnota: ", nota)
      escreva("\nconceito: ", conceito)
}
}
}
