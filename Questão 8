inteiro num, positivo=0, negativo=0, zero=0

    para(inteiro i=1; i<=20; i++){
      escreva("Digite um número\n")
      leia(num)
    
    se(num>=1){
      positivo++
}
    se(num<0){
      negativo++
}
    se(num==0){
      zero++
}
}
    escreva("A quantidade de números positivos é ", positivo, "\n")
    escreva("A quantidade de números negativos é ", negativo, "\n")
    escreva("A quantidade de números zeros é ", zero)
}
}
